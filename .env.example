# Firefly III 实例地址（不含 /api/v1 后缀，例如 https://firefly.example.com 或 http://localhost:8080）
FIREFLY_III_URL=http://localhost:8080

# Firefly III Personal Access Token (在 Firefly III -> Options -> Profile -> OAuth -> Personal Access Tokens 中生成)
FIREFLY_III_PAT=your_personal_access_token_here

# 可选：HTTP 请求超时时间（毫秒，默认 30000）
FIREFLY_III_TIMEOUT_MS=30000
